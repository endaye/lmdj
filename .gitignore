### LMDJ
# Headless Core build outputs
build/core/

# Local release prepare plans and signed asset staging
build/release/

# Pinned toolchains installed by Web CI and local proofs
build/toolchains/

# Formal Web toolchain and browser proof outputs
build/web/
tests/platform/web/test-results/
# Deterministically regenerated at Playwright config load by
# creator/fixtures/make_capture_fixture.mjs; tracking it would only add a
# binary that every run can rebuild, and leaving it untracked would make
# each proof dirty the tree it requires to be clean.
tests/platform/web/creator/fixtures/capture-*.wav
tests/platform/web/playwright-report/
# Privacy-safe local Creator acceptance exports
lmdj-creator-web-*.json

# Reference demo run artifacts (pipeline output packages)
demos/lmdj-song-pipeline/output/

# Local manual/e2e audio corpus (see testdata/audio/suno/README.md)
testdata/audio/suno/**/*.mp3

# Agent session scratch (SDD ledger, task briefs, review packages)
.local/handoffs/
.orchestration/

# Local isolated git worktrees
.worktrees/

# Playwright MCP cache
.playwright-mcp/

# Local environment overrides
.env
**/worktrees/
.aider*

# Local Netlify folder
.netlify
