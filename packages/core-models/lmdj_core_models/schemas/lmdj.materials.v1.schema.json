{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmdj.dev/schemas/lmdj.materials.v1.schema.json",
  "title": "LMDJ internal material package contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "provenance", "timing", "materials", "pattern", "slot_decisions"],
  "properties": {
    "schema": {"const": "lmdj.materials.v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_sha256"],
      "properties": {
        "audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "separator_id",
        "separator_checkpoint_sha256",
        "separator_runner_version",
        "timing_version",
        "extractor_runner_version",
        "extraction_config_version",
        "environment_lock_sha256",
        "pipeline"
      ],
      "properties": {
        "separator_id": {"type": "string", "minLength": 1},
        "separator_checkpoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "separator_runner_version": {"type": "string", "minLength": 1},
        "timing_version": {"type": "string", "minLength": 1},
        "extractor_runner_version": {"type": "string", "minLength": 1},
        "extraction_config_version": {"type": "string", "minLength": 1},
        "environment_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pipeline": {"const": "materials-v1"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bpm", "beats_per_bar", "grid_per_beat", "length_steps", "artifact"],
      "properties": {
        "bpm": {"type": "number", "exclusiveMinimum": 0},
        "beats_per_bar": {"type": "integer", "minimum": 1},
        "grid_per_beat": {"type": "integer", "minimum": 1},
        "length_steps": {"type": "integer", "minimum": 1},
        "artifact": {"$ref": "#/$defs/safePath"}
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/material"}
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern_id", "length_steps", "events"],
      "properties": {
        "pattern_id": {"type": "string", "minLength": 1},
        "length_steps": {"type": "integer", "minimum": 1},
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["material_id", "step", "velocity"],
            "properties": {
              "material_id": {"type": "string", "minLength": 1},
              "step": {"type": "integer", "minimum": 0},
              "velocity": {"type": "integer", "minimum": 1, "maximum": 127}
            }
          }
        }
      }
    },
    "slot_decisions": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/slotDecision"}
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id", "slot_index", "role", "variant", "variant_of", "kind",
        "source_stem", "audio_path", "playback", "quality"
      ],
      "properties": {
        "material_id": {"type": "string", "minLength": 1},
        "slot_index": {"type": "integer", "minimum": 0, "maximum": 15},
        "role": {
          "enum": ["kick", "snare", "hat", "percussion", "bass", "melody", "vocal", "full_mix_phrase"]
        },
        "variant": {"enum": ["A", "B"]},
        "variant_of": {"type": ["string", "null"]},
        "kind": {"enum": ["one_shot", "loop", "full_mix_phrase"]},
        "source_stem": {"enum": ["drums", "bass", "other", "vocals", "original"]},
        "audio_path": {"$ref": "#/$defs/safePath"},
        "playback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quantize", "exclusive_group"],
          "properties": {
            "quantize": {"const": "1/16"},
            "exclusive_group": {"type": ["string", "null"]}
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "score", "warnings"],
          "properties": {
            "status": {"const": "accepted"},
            "score": {"type": "number", "minimum": 0, "maximum": 1},
            "warnings": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "slotDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_index", "status"],
      "properties": {
        "slot_index": {"type": "integer", "minimum": 0, "maximum": 15},
        "status": {"enum": ["accepted", "empty"]},
        "material_id": {"type": "string", "minLength": 1},
        "reason": {
          "enum": [
            "source_silent",
            "no_candidate",
            "classification_low_confidence",
            "quality_below_threshold",
            "variant_not_distinct",
            "no_valid_loop_boundary",
            "source_stem_unavailable"
          ]
        }
      }
    }
  }
}
