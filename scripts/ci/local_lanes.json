{
  "schema": "lmdj.ci-local-lanes.v1",
  "lanes": {
    "docs_static": {
      "requires": {},
      "commands": [
        "git diff --check {base} {head}"
      ],
      "ci_only": []
    },
    "portal": {
      "requires": {
        "commands": ["node", "npm"]
      },
      "commands": [
        "scripts/docs-site.sh install",
        "scripts/docs-site.sh check"
      ],
      "ci_only": [
        "npm --prefix apps/docs-site run check:impact reads the Pull Request body, which these lane commands do not supply; scripts/local-ci.sh --pr-body FILE runs that same check locally, outside the lane and its cache"
      ]
    },
    "ci_contract": {
      "quick": {
        "requires": {"commands": ["python3"]},
        "commands": [
          "python3 scripts/ci/contract_selection.py --base {base} --execute all",
          "python3 -m unittest discover -s tests/quality -p '*_test.py'"
        ],
        "ci_only": [
          "PR CI also runs pinned actionlint; unknown or affected PR-Agent dependencies retain the Python 3.12 real-handler seam."
        ]
      },
      "requires": {
        "commands": ["curl", "python3.12"]
      },
      "commands": [
        "python3 -m unittest discover -s tests/build -p 'ci_*_test.py'",
        "python3 -m unittest discover -s tests/quality -p '*_test.py'",
        "scripts/ci/pr-agent/integration-test.sh"
      ],
      "ci_only": [
        "actionlint runs from a pinned release archive the lane downloads",
        "the real PR-Agent seam proof downloads its fixed upstream archive and installs the hash-locked Python 3.12 environment"
      ]
    },
    "core_ubuntu": {
      "quick": {
        "requires": {
          "os": [
            "linux"
          ],
          "commands": [
            "cmake",
            "python3"
          ]
        },
        "commands": [
          "python3 tests/fixtures/audio/make_fixtures.py",
          "python3 tests/fixtures/golden/reference_render.py",
          "bash scripts/verify-core-dependencies.sh",
          "scripts/core.sh configure dev",
          "scripts/core.sh build dev",
          "scripts/core.sh test dev fast"
        ],
        "ci_only": [
          "Fast unit/component development feedback; the daily risk policy separately retains persistence, host, platform and concurrency checks."
        ]
      },
      "requires": {
        "os": [
          "linux"
        ],
        "commands": [
          "cmake",
          "python3"
        ]
      },
      "commands": [
        "python3 tests/fixtures/audio/make_fixtures.py",
        "python3 tests/fixtures/golden/reference_render.py",
        "bash scripts/verify-core-dependencies.sh",
        "scripts/core.sh proof"
      ],
      "ci_only": [
        "the Apple-only audio target absence check, which asserts a property of the Ubuntu build itself",
        "git lfs checkout -- tests/fixtures rehydrates the complete Core test fixture corpus"
      ]
    },

    "core_asan": {
      "requires": {
        "os": ["linux"]
      },
      "commands": [
        "python3 tests/fixtures/audio/make_fixtures.py",
        "python3 tests/fixtures/golden/reference_render.py",
        "bash scripts/verify-core-dependencies.sh",
        "scripts/core.sh configure asan",
        "scripts/core.sh build asan",
        "scripts/core.sh test asan full",
        "scripts/core.sh test asan stress"
      ],
      "ci_only": [
        "git lfs checkout -- tests/fixtures rehydrates the complete Core test fixture corpus"
      ]
    },
    "core_coverage": {
      "requires": {
        "os": ["linux"],
        "commands": ["clang-22", "clang++-22", "llvm-cov-22"]
      },
      "commands": [
        "python3 tests/fixtures/audio/make_fixtures.py",
        "python3 tests/fixtures/golden/reference_render.py",
        "bash scripts/verify-core-dependencies.sh",
        "env PATH=\"/usr/lib/llvm-22/bin:$PATH\" CC=clang-22 CXX=clang++-22 scripts/core-coverage.sh check"
      ],
      "ci_only": [
        "git lfs checkout -- tests/fixtures rehydrates the complete Core test fixture corpus"
      ]
    },
    "core_macos": {
      "quick": {
        "requires": {
          "os": [
            "darwin"
          ],
          "commands": [
            "cmake",
            "python3"
          ]
        },
        "commands": [
          "python3 tests/fixtures/audio/make_fixtures.py",
          "python3 tests/fixtures/golden/reference_render.py",
          "bash scripts/verify-core-dependencies.sh",
          "scripts/core.sh configure dev",
          "scripts/core.sh build dev",
          "scripts/core.sh test dev fast"
        ],
        "ci_only": [
          "Fast unit/component development feedback; the daily risk policy separately retains persistence, host, platform and concurrency checks."
        ]
      },
      "requires": {
        "os": [
          "darwin"
        ]
      },
      "commands": [
        "python3 tests/fixtures/audio/make_fixtures.py",
        "python3 tests/fixtures/golden/reference_render.py",
        "bash scripts/verify-core-dependencies.sh",
        "scripts/core.sh proof",
        "scripts/core.sh configure asan",
        "scripts/core.sh build asan",
        "ctest --preset asan -L '^native$' --output-on-failure"
      ],
      "ci_only": [
        "the Apple-only sanitizer target presence check",
        "git lfs checkout -- tests/fixtures rehydrates the complete Core test fixture corpus"
      ]
    },

    "web_toolchain": {
      "requires": {
        "commands": ["cmake", "node", "npm"],
        "any_of": [
          {"path": "build/toolchains/emsdk/emsdk_env.sh"},
          {"env": "EMSDK"}
        ]
      },
      "commands": [
        "scripts/web-toolchain-conformance.sh proof"
      ],
      "ci_only": [
        "emsdk install/activate and playwright install --with-deps provision the toolchain the local run expects to already exist"
      ]
    },
    "web_runtime_host": {
      "requires": {
        "commands": [
          "cmake",
          "node",
          "npm"
        ],
        "any_of": [
          {
            "path": "build/toolchains/emsdk/emsdk_env.sh"
          },
          {
            "env": "EMSDK"
          }
        ]
      },
      "commands": [
        "python3 tools/web-runtime/verify_emscripten.py",
        "scripts/web-runtime-host.sh proof"
      ],
      "ci_only": [
        "emsdk install/activate and playwright install --with-deps provision the toolchain the local run expects to already exist",
        "git lfs checkout -- tests/fixtures/audio rehydrates the deterministic audio fixtures"
      ],
      "journey": {
        "requires": {
          "commands": [
            "cmake",
            "node",
            "npm"
          ],
          "any_of": [
            {
              "path": "build/toolchains/emsdk/emsdk_env.sh"
            },
            {
              "env": "EMSDK"
            }
          ]
        },
        "commands": [
          "python3 tools/web-runtime/verify_emscripten.py",
          "scripts/web-runtime-host.sh quick"
        ],
        "ci_only": [
          "Complete Runtime browser journeys with one incremental build; release reproducibility remains unverified."
        ]
      }
    },

    "creator": {
      "quick": {
        "requires": {
          "commands": [
            "cmake",
            "node",
            "npm"
          ],
          "any_of": [
            {
              "path": "build/toolchains/emsdk/emsdk_env.sh"
            },
            {
              "env": "EMSDK"
            }
          ],
          "clean_worktree": true
        },
        "commands": [
          "scripts/creator-web.sh smoke"
        ],
        "ci_only": [
          "Daily build/unit/offline and complete authoring/playback/reload smoke; other browser cases and reproducibility remain unverified."
        ]
      },
      "requires": {
        "commands": [
          "cmake",
          "node",
          "npm"
        ],
        "any_of": [
          {
            "path": "build/toolchains/emsdk/emsdk_env.sh"
          },
          {
            "env": "EMSDK"
          }
        ],
        "clean_worktree": true
      },
      "commands": [
        "scripts/creator-web.sh proof"
      ],
      "ci_only": [
        "emsdk install/activate and playwright install --with-deps provision the toolchain the local run expects to already exist",
        "git lfs checkout -- tests/fixtures/audio rehydrates the deterministic audio fixtures"
      ],
      "journey": {
        "requires": {
          "commands": [
            "cmake",
            "node",
            "npm"
          ],
          "any_of": [
            {
              "path": "build/toolchains/emsdk/emsdk_env.sh"
            },
            {
              "env": "EMSDK"
            }
          ],
          "clean_worktree": true
        },
        "commands": [
          "scripts/creator-web.sh quick"
        ],
        "ci_only": [
          "Complete browser journeys with one incremental build; release reproducibility remains unverified."
        ]
      }
    },

    "web_runtime_lab": {
      "requires": {
        "commands": ["node", "npm"]
      },
      "commands": [
        "scripts/web-runtime-lab.sh test"
      ],
      "ci_only": []
    },
    "deploy_contract": {
      "requires": {},
      "commands": [
        "python3 tests/build/release_suite_runner.py",
        "python3 tests/build/web_runtime_deploy_workflow_test.py",
        "python3 tests/build/creator_web_deploy_workflow_test.py",
        "python3 tests/build/web_host_deploy_workflow_parity_test.py",
        "python3 tests/build/default_assets_deploy_workflow_test.py",
        "python3 tests/build/web_host_release_selection_test.py",
        "python3 tests/build/web_runtime_public_deployment_docs_test.py",
        "python3 tests/build/creator_web_public_deployment_docs_test.py",
        "python3 apps/web-runtime-host/test/deploy_command_test.py",
        "python3 apps/creator-web/test/deploy_command_test.py"
      ],
      "ci_only": [
        "the deploy command suite pins --shards 4 to the hosted runner's four vCPUs; the local run takes the default min(4, os.cpu_count())",
        "the release suite runner pins --shards 4 on the runner; the local run takes the default min(4, os.cpu_count())"
      ]
    },
    "package": {
      "requires": {
        "clean_worktree": true
      },
      "commands": [
        "scripts/core.sh package"
      ],
      "ci_only": [
        "git lfs checkout -- tests/fixtures rehydrates the complete Core test fixture corpus"
      ]
    }
  }
}
