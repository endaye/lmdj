      "expected_layer": "syntax"
    },
    {
      "name": "Infinity",
      "raw_json": "{\"contract\":\"lmdj.slice-points.v1\",\"source_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"frame_rate\":48000,\"points\":[{\"frame\":0,\"confidence\":Infinity}]}",
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
