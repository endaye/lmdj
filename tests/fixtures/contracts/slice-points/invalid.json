      "expected_layer": "syntax"
    },
    {
      "name": "float overflow",
      "raw_json": "{\"contract\":\"lmdj.slice-points.v1\",\"source_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"frame_rate\":48000,\"points\":[{\"frame\":0,\"confidence\":1e999}]}",
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "syntax"
    },
    {
      "name": "lone surrogate",
      "raw_json": "{\"contract\":\"lmdj.slice-points.v1\",\"source_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"frame_rate\":48000,\"points\":[{\"frame\":0,\"label\":\"\\ud800\"}]}",
