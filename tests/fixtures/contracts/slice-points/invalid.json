      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "missing required property 'contract'"
    },
    {
      "name": "missing source_sha256",
      "payload": {
