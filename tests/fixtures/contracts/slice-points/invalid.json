{
  "cases": [
    {
      "name": "EOF is not an onset",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {
            "frame": 1000
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "context",
      "expected_error": "frame outside source"
    },
    {
      "name": "negative frame",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {
            "frame": -1
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "below minimum"
    },
    {
      "name": "fractional frame",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {
            "frame": 0.5
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "expected type"
    },
    {
      "name": "boolean frame",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {
            "frame": true
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "expected type"
    },
    {
      "name": "unsafe integer frame",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {
            "frame": 9007199254740992
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "above maximum"
    },
    {
      "name": "duplicate frames",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {
            "frame": 0
          },
          {
            "frame": 0
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "context",
      "expected_error": "frames not strictly increasing"
    },
    {
      "name": "descending frames",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {
            "frame": 10
          },
          {
            "frame": 0
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "context",
      "expected_error": "frames not strictly increasing"
    },
    {
      "name": "wrong source binding",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "frame_rate": 48000,
        "points": [
          {
            "frame": 0
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "context",
      "expected_error": "source hash mismatch"
    },
    {
      "name": "wrong rate binding",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 44100,
        "points": [
          {
            "frame": 0
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "context",
      "expected_error": "source rate mismatch"
    },
    {
      "name": "zero rate",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 0,
        "points": [
          {
            "frame": 0
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "below minimum"
    },
    {
      "name": "boolean rate",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": true,
        "points": [
          {
            "frame": 0
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "expected type"
    },
    {
      "name": "malformed hash",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "frame_rate": 48000,
        "points": [
          {
            "frame": 0
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "does not match pattern"
    },
    {
      "name": "wrong contract",
      "payload": {
        "contract": "lmdj.slice-points.v2",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {
            "frame": 0
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "expected const"
    },
    {
      "name": "extra root key",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {
            "frame": 0
          }
        ],
        "path": "/source.wav"
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "'path' is not allowed"
    },
    {
      "name": "extra point key",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {
            "frame": 0,
            "seconds": 0
          }
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "'seconds' is not allowed"
    },
    {
      "name": "missing frame",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {}
        ]
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "missing required property 'frame'"
    },
    {
      "name": "missing points",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000
      },
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "schema",
      "expected_error": "missing required property 'points'"
    },
    {
      "name": "empty label",
      "payload": {
        "contract": "lmdj.slice-points.v1",
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "points": [
          {
            "frame": 0,
            "label": ""
