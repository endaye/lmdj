    {
      "name": "duplicate JSON keys",
      "raw_json": "{\"contract\":\"lmdj.slice-points.v1\",\"source_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"frame_rate\":48000,\"frame_rate\":48000,\"points\":[{\"frame\":0}]}",
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
      },
      "expected_layer": "syntax"
    },
    {
      "name": "NaN",
      "raw_json": "{\"contract\":\"lmdj.slice-points.v1\",\"source_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"frame_rate\":48000,\"points\":[{\"frame\":0,\"confidence\":NaN}]}",
      "context": {
        "source_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "frame_rate": 48000,
        "frame_count": 1000
