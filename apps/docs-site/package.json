{
  "name": "@lmdj/docs-site",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run validate:changelogs && docusaurus start",
    "changelogs": "node scripts/generate-host-changelogs.mjs --write",
    "validate:changelogs": "node scripts/generate-host-changelogs.mjs --check && node scripts/generate-release-changelogs.mjs --check",
    "release-changelogs": "node scripts/generate-release-changelogs.mjs --write",
    "facts": "node scripts/generate-facts.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "diagrams": "node scripts/render-diagrams.mjs",
    "validate:diagrams": "node scripts/validate-diagrams.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:impact": "node scripts/check-doc-impact.mjs",
    "check:snapshot-projection": "node scripts/check-snapshot-projection.mjs",
    "check:release-docs": "node scripts/check-release-docs.mjs",
    "version:docs": "node scripts/version-docs.mjs",
    "build": "npm run validate:changelogs && npm run facts && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check:current": "npm test && npm run validate:docs && npm run validate:diagrams && npm run facts && npm run typecheck && npm run build && npm run check:build",
    "check": "npm test && npm run validate:docs && npm run validate:diagrams && npm run facts && npm run check:release-docs && npm run typecheck && npm run build && npm run check:build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.2.18",
    "cheerio": "1.2.0",
    "glob": "13.0.6",
    "gray-matter": "4.0.3",
    "typescript": "6.0.2",
    "yaml": "2.9.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
