  "cards": [
    {
      "title": "Dependencies",
      "body": "Full Facade links Performance Runtime and Runtime-only Facade, two independent narrow targets in the same Module. Runtime-only links Cooker/Audio, never Project IO or Provider SDK. Host owner selector → Facade → SDK policy/binding/budget gates → Project IO verified Asset read under one writer lease → owned source/sink. Session grants reset on restart; durable Attempts never contain Project paths or alter Truth."
    },
    {
      "title": "Runtime content export",
      "body": "Expected Project ID/revision + one Pattern + extra live Pads. Load verified Truth, narrow a detached value, Cook and encode; return opaque bytes plus complete identity. No Project write or runtime publication."
    },
    {
      "title": "Performance authority",
      "body": "Twenty Performance operations plus three Pattern Slot commands; open gestures, HOLD and the last acknowledged launch come from record status, never from Host prediction."
    },
    {
      "title": "Runtime boundary",
      "body": "Budget Engine plus 2176-state receipt-bounded storage. Acquire consumption, drain states, retire receipts. OPEN/BUSY drain before reclaim. No physical-device proof."
    }
  ]
