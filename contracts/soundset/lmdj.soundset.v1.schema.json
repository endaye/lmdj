{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmdj.dev/contracts/soundset/lmdj.soundset.v1.schema.json",
  "x-lmdj-contract-version": "1.1.0",
  "title": "LMDJ Sound Set Contract v1",
  "type": "object",
  "required": [
    "contract",
    "set_id",
    "version",
    "name",
    "publisher",
    "license",
    "slots"
  ],
  "properties": {
    "contract": {
      "const": "lmdj.soundset.v1"
    },
    "set_id": {
      "$ref": "#/$defs/uuid"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "bpm": {
      "type": "integer",
      "minimum": 40,
      "maximum": 240
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "demo": {
      "$ref": "#/$defs/artifact_ref"
    },
    "slots": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/slot"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 0
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 1
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 2
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 3
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 4
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 5
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 6
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 7
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 8
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 9
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 10
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 11
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 12
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 13
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 14
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "const": 15
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "license": {
      "type": "object",
      "required": [
        "spdx_id",
        "rights_holder",
        "copyright",
        "attribution"
      ],
      "properties": {
        "spdx_id": {
          "type": "string",
          "minLength": 1
        },
        "rights_holder": {
          "type": "string",
          "minLength": 1
        },
        "copyright": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifact_ref": {
      "type": "object",
      "required": [
        "sha256",
        "media_type",
        "byte_length"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "slot": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "slot"
          ],
          "properties": {
            "slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "slot",
            "role",
            "name",
            "artifact"
          ],
          "properties": {
            "slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "role": {
              "enum": [
                "kick",
                "snare",
                "clap",
                "hat_closed",
                "hat_open",
                "perc",
                "cymbal",
                "bass",
                "melody",
                "chord",
                "vocal",
                "fx",
                "other"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "$ref": "#/$defs/artifact_ref"
            },
            "bpm": {
              "type": "integer",
              "minimum": 40,
              "maximum": 240
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
