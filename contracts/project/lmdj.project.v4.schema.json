{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmdj.dev/contracts/project/lmdj.project.v4.schema.json",
  "x-lmdj-contract-version": "4.0.0",
  "title": "LMDJ Project Truth v4",
  "type": "object",
  "required": [
    "contract",
    "project_id",
    "revision",
    "bpm",
    "sequence_settings",
    "banks",
    "assets",
    "patterns",
    "pattern_slots",
    "performances"
  ],
  "properties": {
    "contract": {
      "const": "lmdj.project.v4"
    },
    "project_id": {
      "$ref": "#/$defs/uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "bpm": {
      "type": "integer",
      "minimum": 40,
      "maximum": 240
    },
    "sequence_settings": {
      "$ref": "#/$defs/sequence_settings"
    },
    "banks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/bank"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "bank"
            ],
            "properties": {
              "bank": {
                "const": 0
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "bank"
            ],
            "properties": {
              "bank": {
                "const": 1
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "bank"
            ],
            "properties": {
              "bank": {
                "const": 2
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "bank"
            ],
            "properties": {
              "bank": {
                "const": 3
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "uniqueItems": true
    },
    "patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pattern"
      },
      "uniqueItems": true
    },
    "pattern_slots": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/uuid"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "performances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/performance"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "required": [
        "sha256",
        "media_type",
        "byte_length"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "asset_artifact_lineage_source": {
      "type": "object",
      "required": [
        "kind",
        "artifact_sha256",
        "project_revision"
      ],
      "properties": {
        "kind": {
          "const": "asset_artifact"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "resample_frame_range": {
      "type": "object",
      "required": [
        "start_frame",
        "end_frame"
      ],
      "properties": {
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "resample_lineage_derivation": {
      "type": "object",
      "required": [
        "kind",
        "range",
        "performance_id"
      ],
      "properties": {
        "kind": {
          "const": "resample"
        },
        "range": {
          "$ref": "#/$defs/resample_frame_range"
        },
        "performance_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "asset_lineage": {
      "type": "object",
      "required": [
        "source",
        "derivation"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/asset_artifact_lineage_source"
        },
        "derivation": {
          "$ref": "#/$defs/resample_lineage_derivation"
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "asset_id",
        "artifact",
        "lineage"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/uuid"
        },
        "artifact": {
          "$ref": "#/$defs/artifact_ref"
        },
        "lineage": {
          "oneOf": [
            {
              "$ref": "#/$defs/asset_lineage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "sequence_settings": {
      "type": "object",
      "required": [
        "quantize_enabled",
        "swing_percent"
      ],
      "properties": {
        "quantize_enabled": {
          "type": "boolean"
        },
        "swing_percent": {
          "type": "integer",
          "minimum": 50,
          "maximum": 75
        }
      },
      "additionalProperties": false
    },
    "playback": {
      "type": "object",
      "required": [
        "trim_start_frame",
        "trim_end_frame",
        "trigger_mode",
        "gain_millidb",
        "muted"
      ],
      "properties": {
        "trim_start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "trim_end_frame": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "trigger_mode": {
          "enum": [
            "one_shot",
            "gate",
            "loop_gate",
            "loop_toggle"
          ]
        },
        "gain_millidb": {
          "type": "integer",
          "minimum": -60000,
          "maximum": 6000
        },
        "muted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "pad": {
      "type": "object",
      "required": [
        "pad",
        "asset_id",
        "playback"
      ],
      "properties": {
        "pad": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "asset_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "playback": {
          "$ref": "#/$defs/playback"
        }
      },
      "additionalProperties": false
    },
    "bank": {
      "type": "object",
      "required": [
        "bank",
        "pads"
      ],
      "properties": {
        "bank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "pads": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/pad"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "required": [
        "bank",
        "pad"
      ],
      "properties": {
        "bank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "pad": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      },
      "additionalProperties": false
    },
    "pattern_event": {
      "type": "object",
      "required": [
        "slot",
        "onset_tick",
        "duration_tick",
        "velocity"
      ],
      "properties": {
        "slot": {
          "$ref": "#/$defs/slot"
        },
        "onset_tick": {
          "type": "integer",
          "minimum": 0
        },
        "duration_tick": {
          "type": "integer",
          "minimum": 1
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        }
      },
      "additionalProperties": false
    },
    "pattern": {
      "type": "object",
      "required": [
        "pattern_id",
        "bars",
        "events"
      ],
      "properties": {
        "pattern_id": {
          "$ref": "#/$defs/uuid"
        },
        "bars": {
          "enum": [
            1,
            2,
            4,
            8
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pattern_event"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "bars": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "events": {
                "items": {
                  "properties": {
                    "onset_tick": {
                      "maximum": 3839
                    },
                    "duration_tick": {
                      "maximum": 3840
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "bars": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "events": {
                "items": {
                  "properties": {
                    "onset_tick": {
                      "maximum": 7679
                    },
                    "duration_tick": {
                      "maximum": 7680
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "bars": {
                "const": 4
              }
            }
          },
          "then": {
            "properties": {
              "events": {
                "items": {
                  "properties": {
                    "onset_tick": {
                      "maximum": 15359
                    },
                    "duration_tick": {
                      "maximum": 15360
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "bars": {
                "const": 8
              }
            }
          },
          "then": {
            "properties": {
              "events": {
                "items": {
                  "properties": {
                    "onset_tick": {
                      "maximum": 30719
                    },
                    "duration_tick": {
                      "maximum": 30720
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "performance_pad_hit_event": {
      "type": "object",
      "required": [
        "kind",
        "slot",
        "onset_tick",
        "duration_tick",
        "velocity"
      ],
      "properties": {
        "kind": {
          "const": "pad_hit"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "onset_tick": {
          "type": "integer",
          "minimum": 0
        },
        "duration_tick": {
          "type": "integer",
          "minimum": 1
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        }
      },
      "additionalProperties": false
    },
    "performance_pattern_launch_event": {
      "type": "object",
      "required": [
        "kind",
        "pattern_slot",
        "effective_tick"
      ],
      "properties": {
        "kind": {
          "const": "pattern_launch"
        },
        "pattern_slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "effective_tick": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "performance_fx_engage_event": {
      "type": "object",
      "required": [
        "kind",
        "fx",
        "value",
        "tick"
      ],
      "properties": {
        "kind": {
          "const": "fx_engage"
        },
        "fx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "performance_fx_move_event": {
      "type": "object",
      "required": [
        "kind",
        "fx",
        "value",
        "tick"
      ],
      "properties": {
        "kind": {
          "const": "fx_move"
        },
        "fx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "performance_fx_release_event": {
      "type": "object",
      "required": [
        "kind",
        "fx",
        "tick"
      ],
      "properties": {
        "kind": {
          "const": "fx_release"
        },
        "fx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "performance_hold_on_event": {
      "type": "object",
      "required": [
        "kind",
        "tick"
      ],
      "properties": {
        "kind": {
          "const": "hold_on"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "performance_hold_off_event": {
      "type": "object",
      "required": [
        "kind",
        "tick"
      ],
      "properties": {
        "kind": {
          "const": "hold_off"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "performance_event": {
      "oneOf": [
        {
          "$ref": "#/$defs/performance_pad_hit_event"
        },
        {
          "$ref": "#/$defs/performance_pattern_launch_event"
        },
        {
          "$ref": "#/$defs/performance_fx_engage_event"
        },
        {
          "$ref": "#/$defs/performance_fx_move_event"
        },
        {
          "$ref": "#/$defs/performance_fx_release_event"
        },
        {
          "$ref": "#/$defs/performance_hold_on_event"
        },
        {
          "$ref": "#/$defs/performance_hold_off_event"
        }
      ]
    },
    "performance": {
      "type": "object",
      "required": [
        "performance_id",
        "name",
        "created_bpm",
        "recording_revision",
        "recording_artifact",
        "events"
      ],
      "properties": {
        "performance_id": {
          "$ref": "#/$defs/uuid"
        },
      "name": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[\\s\\S]{1,64}(?![\\s\\S])"
      },
        "created_bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 240
        },
        "recording_revision": {
          "type": "integer",
          "minimum": 0
        },
        "recording_artifact": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/performance_event"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
